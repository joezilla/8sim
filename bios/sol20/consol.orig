C302                  0747 *
C302                  0748 *   COMPARE DE AND HL
C302                  0749 *
C302 7D               0750 ACOMP    MOV      A,L
C303 93               0751          SUB      E
C304 7C               0752          MOV      A,H
C305 9A               0753          SBB      D
