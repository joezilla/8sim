C1FA BE               0531          CMP      M          TEST FIRST CHR
C1FB 13               0532          INX      D
C1FC C2 0B C2         0533          JNZ      NCOM
C1FF                  0534 *
C1FF 23               0535          INX      H
C200 1A               0536          LDAX     D
C201 BE               0537          CMP      M          NOW SECOND CHARACTER
