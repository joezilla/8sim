# fdcplus-web server used by examples/boot-cpm.ts (npm run boot:cpm) and the
# live boot test (tests/integration/bootdisk.live.test.ts).
# Copy this file to .env and fill in your values — .env is gitignored.

# Base URL of the fdcplus-web server (the WebSocket URL is derived from it).
FDCPLUS_URL=http://localhost:3000

# API token for the fdcplus-web server.
FDCPLUS_TOKEN=

# Optional stable client id. fdcplus-web disk writes go to a per-client
# copy-on-write "splinter"; without a client id the splinter (and your saved
# files) is discarded when the session disconnects.
FDCPLUS_CLIENT_ID=

# CPU speed for the boot:cpm example: 2mhz (default, stock 8080), 4mhz,
# a raw Hz number (e.g. 2000000), or max for unthrottled.
CPU_HZ=2mhz
